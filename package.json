{
  "name": "tina-standalone",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev -c 'eleventy --input='site' --serve --port $PORT' ",
    "dev:prod": "TINA_PUBLIC_IS_LOCAL=false tinacms dev -c 'eleventy --input='site' --serve'",
    "build": "tinacms build --verbose && eleventy --input='site'",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tinacms/cli": "^4.0.4",
    "@tinacms/datalayer": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mongodb-level": "^0.0.2",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^3.2.0",
    "tinacms": "^3.14.0",
    "tinacms-authjs": "^24.0.5",
    "tinacms-gitprovider-github": "^5.0.0",
    "tsx": "^3.14.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^3.2.29",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  }
}
